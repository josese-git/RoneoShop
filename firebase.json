{
  "hosting": {
    "site": "roneoshop-es",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "_dawn_ref/**",
      "_yoana_real/**",
      "worker-redsys/**"
    ],
    "rewrites": [
      {
        "source": "/api/packlink/**",
        "function": "packlinkProxy"
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}

