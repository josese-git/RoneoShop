rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == '1roneoshop@gmail.com';
    }

    // Catálogo de prendas: lectura pública, mutaciones solo administrador
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configuración global de la tienda: lectura pública, mutaciones solo administrador
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos de compra:
    // Creación pública permitida exclusivamente para registrar pedidos legítimos desde el checkout
    // Lectura, actualización y borrado restringidos exclusivamente al administrador
    match /orders/{orderId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.orderNumber == orderId
        && request.resource.data.keys().hasAll(['orderNumber', 'customer', 'items', 'total', 'createdAt'])
        && request.resource.data.total is number
        && request.resource.data.total > 0;
    }
  }
}
