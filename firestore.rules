rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == '1roneoshop@gmail.com';
    }

    // Catálogo de prendas: lectura pública, mutaciones solo administrador
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configuración global de la tienda: lectura pública, mutaciones solo administrador
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos de compra:
    // Creación permitida para pedidos legítimos desde el checkout (invitados o usuarios autenticados)
    // Lectura permitida para el administrador o el cliente propietario del pedido (customerUid)
    // Actualización y borrado restringidos exclusivamente al administrador
    match /orders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.customerUid == request.auth.uid);
      allow update, delete: if isAdmin();
      allow create: if request.resource.data.orderNumber == orderId
        && request.resource.data.keys().hasAll(['orderNumber', 'customer', 'items', 'total', 'createdAt'])
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && (!('customerUid' in request.resource.data) || request.resource.data.customerUid == null || (request.auth != null && request.resource.data.customerUid == request.auth.uid));
    }

    // Perfil y datos de clientes autenticados:
    match /users/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();

      // Favoritos de prendas por usuario:
      match /favorites/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
